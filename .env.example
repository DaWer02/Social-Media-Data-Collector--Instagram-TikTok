# Instagram Graph API Configuration
# JANGAN PERNAH menaruh token nyata atau commit file .env ke Git repository!

# Access Token dari Meta for Developers (User/Page Access Token yang memiliki izin)
INSTAGRAM_ACCESS_TOKEN=

# Varian API Instagram: 'facebook_login' (default, graph.facebook.com) atau 'instagram_login' (graph.instagram.com)
INSTAGRAM_API_VARIANT=facebook_login

# Versi Meta Graph API (contoh: v21.0)
GRAPH_API_VERSION=v21.0

# Target jumlah komentar maksimum yang dikumpulkan (default: 3000)
TARGET_COMMENTS=3000

# Konfigurasi Lingkungan
APP_ENV=development
LOG_LEVEL=INFO
