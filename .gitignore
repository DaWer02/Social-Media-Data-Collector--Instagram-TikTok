# =============================================================================
# .gitignore — Social Media Data Collector (Instagram & TikTok)
# Privacy-First Open Source Repository
# =============================================================================

# --- Environment & Secrets ---
.env
.env.local
.env.*
*.env

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Browser Profiles & Session Storage (Private Credential Protection) ---
.browser_profile/
data/.browser_profile/
chrome_debug.log
Crashpad/
playwright-report/
test-results/
blob-report/
*.pma

# --- Data Directories (Strict Privacy: Protect Collected Scraped Data) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/annotated/*
!data/annotated/.gitkeep
data/predictions/*
!data/predictions/.gitkeep
data/indonesia/*
data/malaysia/*
data/*.xlsx
data/*.csv
*.csv
*.xlsx
*.parquet
*.jsonl
!tests/fixtures/*.csv

# --- Machine Learning Models & Execution Run Logs ---
models/*
!models/.gitkeep
reports/*
!reports/.gitkeep

# --- Local User Documents & Analysis Workspace (Kept Local, Not Published) ---
analyst/
doc/

# --- Scratch & Ad-hoc Testing ---
tester/
scratch/

# --- IDEs & System Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
Thumbs.db
Desktop.ini
.DS_Store
._*

# --- Microsoft Office Temporary Lock Files ---
~$*.xlsx
~$*.docx
~$*.pptx
~$*.doc
